  <title>HC-SR04</title>
  <label>HC-SR04</label>
  <description>OpenBot DIY functional wiring symbol. Pin names identify contacts; positions are schematic. License: CC BY-SA 3.0.</description>
  <properties>
    <property name="family">OpenBot DIY wiring</property>
    <property name="part number">HC-SR04</property>
  </properties>
  <views>
