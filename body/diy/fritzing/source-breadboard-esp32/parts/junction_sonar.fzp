<?xml version='1.0' encoding='utf-8'?>
<module moduleId="OpenBot_DIY_esp32_junction_sonar_v1" fritzingVersion="1.0.8">
  <title>Соединение sonar</title>
  <version>1</version>
  <author>nitrobin / OpenBot fork</author>
  <description>Native electrical branch contact; CC BY-SA 3.0.</description>
  <properties>
    <property name="family">OpenBot wiring junction</property>
    <property name="part number">sonar</property>
  </properties>
  <views>
    <breadboardView>
      <layers image="breadboard/junction_sonar.svg">
        <layer layerId="breadboard" />
      </layers>
    </breadboardView>
    <iconView>
      <layers image="icon/junction_sonar.svg">
        <layer layerId="icon" />
      </layers>
    </iconView>
  </views>
  <connectors>
    <connector id="connector0" type="male" name="junction">
      <views>
        <breadboardView>
          <p layer="breadboard" svgId="connector0pin" terminalId="connector0terminal" />
        </breadboardView>
      </views>
    </connector>
  </connectors>
</module>